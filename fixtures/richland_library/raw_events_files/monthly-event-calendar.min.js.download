function showEvents(){var e=jQuery(this);jQuery("td.s-lc-mc-selected-day").removeClass("s-lc-mc-selected-day"),e.closest("td").addClass("s-lc-mc-selected-day");var l=e.data("id"),o=e.data("week"),t="#s-lc-mobile-event-info-"+l+"-"+o;e.data("collapse",t);var s=createEventListCollapseContent(e),a=jQuery(t),n=jQuery("#s-lc-monthly-event-calendar-"+l+" .collapse");return n.off("hidden.bs.collapse"),a.is(":visible")?(a.on("hidden.bs.collapse",function(){a.html(s),a.collapse("show")}),a.collapse("hide"),!1):(n.collapse("hide"),a.html(s),a.collapse("show"),!1)}function createEventListCollapseContent(e){return'<h4 class="text-center margin-top-sm margin-bottom-none"><strong>'+springyMonthly.eventText+" "+e.data("date")+'</strong><button class="close margin-right-med" data-target="'+e.data("collapse")+'" data-toggle="collapse"><i class="fa fa-close fa-2"></i></button></h4><hr class="margin-top-sm margin-bottom-none no-pad">'+e.data("html")}jQuery(".s-lc-monthly-calendar-event-count").on("click",showEvents);
