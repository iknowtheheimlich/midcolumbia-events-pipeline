var calendarUtils={weeklyPartialFormat:"D",weeklyFullFormat:"D MMMM YYYY",monthlyFormat:"MMMM - YYYY",getDateHeading:function(a,l,e){if(l)return a.format(this.monthlyFormat);var r=moment(a).startOf(e),t=moment(a).endOf(e);return r.isSame(t,"month")?r.format(this.weeklyPartialFormat)+" - "+t.format(this.weeklyFullFormat):r.format(this.weeklyFullFormat)+" - "+t.format(this.weeklyFullFormat)},hideICalDetails:function(a){if(jQuery("#s-lc-ical-link, #s-lc-ical-details").hide(),a)return!1;var l=jQuery("#cal-dd").val();if(l.length!==1)return!1;var e=springyCommon.parseInt(l[0]);if(e===springyPage.showAllCalendars)return!1;jQuery("#s-lc-ical-link").show()},getICalParam:function(a,l){return l===void 0||l.length===0?"":"&"+a+"="+l.join(",")},updateICalUrl:function(){var a=springyPage.iCalUrlBase+calendarUtils.getICalParam("cid",jQuery("#cal-dd").val())+calendarUtils.getICalParam("cat",jQuery("#cat-dd").val())+calendarUtils.getICalParam("aud",jQuery("#audience-dd").val())+calendarUtils.getICalParam("cam",jQuery("#cam-dd").val()),l='<a href="'+a+'">'+a+"</a>";jQuery("#s-lc-c-ical-url").html(l)},showICalDetails:function(){return jQuery("#s-lc-ical-link").hide(),jQuery("#s-lc-ical-details").show(),calendarUtils.updateICalUrl(),!1}};
