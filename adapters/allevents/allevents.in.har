3\\/banners\\/63380294585d51ad7b2d2a02f146bad8e876d11eab848439288241b1bf75b68b-rimg-w1200-h800-dcc47146-gmir?v=1783590591\",\"start_time\":\"1783954800\",\"timezone\":\"-07:00\",\"description\":\"Ages 10\\u201317\\n\\nRegistration is required and opens at 3pm Monday, June 22, 2026. Register: https:\\/\\/scld.libcal.com\\/event\\/15880486\\n\\nTurn cookies into delicious art! Baker Catee Ng shares some basic techniques for cookie decorating. Then you can practice your new skills on three cookies that you can take with you.\",\"end_time\":\"1783958400\",\"start_time_display\":\"Jul 13\",\"location\":\"Spokane County Library District (North Spokane Library)\",\"venue\":{\"street\":\"44 E Hawthorne Rd,Country Homes, Washington\",\"venue\":\"Spokane County Library District (North Spokane Library)\",\"city\":\"Fairwood\",\"state\":\"WA\",\"country\":\"United States\",\"latitude\":\"47.75042\",\"longitude\":\"-117.40902\",\"full_address\":\"Spokane County Library District (North Spokane Library), 44 E Hawthorne Rd,Country Homes, Washington, Fairwood, United States\"},\"label\":\"Today\",\"featured\":\"0\",\"event_url\":\"https:\\/\\/allevents.in\\/fairwood\\/event\\/200030252340813?ref=eventsearch-event-results\",\"share_url\":\"https:\\/\\/allevents.in\\/fairwood\\/200030252340813?ref=bottom_sharer_app\",\"share_message\":\"Hey, \\n\\nJust found this amazing event happening in Fairwood on AllEvents.\\n\\nWe should totally go!\\n\\nCookie Decorating \\n\\n Check it out: https:\\/\\/allevents.in\\/fairwood\\/200030252340813?ref=bottom_sharer_app\",\"share_message_wa\":\"Hey, \\n\\nJust found this amazing event happening in Fairwood on AllEvents.\\n\\nWe should totally go!\\n\\nCookie Decorating \\n\\n Check it out: https:\\/\\/allevents.in\\/fairwood\\/200030252340813?ref=bottom_sharer_app\",\"object_type\":\"events\",\"end_url\":\"https:\\/\\/allevents.in\\/fairwood\\/event\\/200030252340813\",\"distance\":0,\"ticket\":{\"has_tickets\":false},\"tickets\":{\"has_tickets\":false},\"recurring_event_details\":{\"has_slots\":false},\"display_day\":\"13\",\"display_month\":\"Jul\",\"display_end_day\":null,\"interested_count\":0,\"custom_params\":{\"total_interested_count\":0},\"params\":[],\"app_display_time\":\"Mon, 13 Jul, 2026\",\"display_time_label\":\"Mon, 13 Jul\",\"card_custom_details\":null,\"show_story_share\":true},{\"event_id\":\"200030239607109\",\"eventname\":\"LEAP Kids Day Camp\",\"thumb_url\":\"https:\\/\\/cdn-az.allevents.in\\/events9\\/banners\\/e80350f80bcd2792e85fe3e6cf408e35a8185c3a37708ddda80a399bfc01b396-rimg-w940-h788-dcffffff-gmir?v=1783520353\",\"thumb_url_large\":\"https:\\/\\/cdn-az.allevents.in\\/events9\\/banners\\/e80350f80bcd2792e85fe3e6cf408e35a8185c3a37708ddda80a399bfc01b396-rimg-w940-h788-dcffffff-gmir?v=1783520353\",\"banner_url\":\"https:\\/\\/cdn-az.allevents.in\\/events9\\/banners\\/e80350f80bcd2792e85fe3e6cf408e35a8185c3a37708ddda80a399bfc01b396-rimg-w940-h788-dcffffff-gmir?v=1783520353\",\"start_time\":\"1783931400\",\"timezone\":\"-07:00\",\"description\":\"Register at: https:\\/\\/www.leapdaycamp.com\\/\\n\\nLearn Enriching Active Play\\nWelcome to our 2026 Summer Day Camp Program!\\nGet ready for a fun-filled summer where we will LEAP \\u2013 Learn with Enriching Active Play!\\nWe will be engaging in lots of outdoor time, active learning time, and even a field trip.\\n\\nBuilding a Robot- Lego Robotics \\nJULY 13 - 17\\n\\nCost: $300\\n\\nDaily Schedule\\nDrop-off will begin at 8:30 AM.\\nDaily activities start at 9 AM and go till 4 PM.\\nPick-up time ending at 4:30. \\n \\n*Lunch and snacks will be included as part of your camp experience.\\n\",\"end_time\":\"1784305800\",\"start_time_display\":\"Jul 13\",\"location\":\"1601 S Sullivan Rd, Spokane Valley, WA\",\"venue\":{\"street\":\"1601 S Sullivan Rd, Spokane Valley, WA 99037-9012, United States\",\"venue\":\"1601 S Sullivan Rd, Spokane Valley, WA\",\"city\":\"Spokane Valley\",\"state\":\"WA\",\"country\":\"United States\",\"latitude\":\"47.64201\",\"longitude\":\"-117.19594\",\"full_address\":\"1601 S Sullivan Rd, Spokane Valley, WA, United States\"},\"label\":\"Today\",\"featured\":\"0\",\"event_url\":\"https:\\/\\/allevents.in\\/spokane-valley\\/event\\/200030239607109?ref=eventsearch-event-results\",\"share_url\":\"https:\\/\\/allevents.in\\/spokane-valley\\/200030239607109?ref=bottom_sharer_app\",\"share_message\":\"Hey, \\n\\nJust found this amazing event happening in Spokane Valley on AllEvents.\\n\\nWe should totally go!\\n\\nLEAP Kids Day Camp \\n\\n Check it out: https:\\/\\/allevents.in\\/spokane-valley\\/200030239607109?ref=bottom_sharer_app\",\"share_message_wa\":\"Hey, \\n\\nJust found this amazing event happening in Spokane Valley on AllEvents.\\n\\nWe should totally go!\\n\\nLEAP Kids Day Camp \\n\\n Check it out: https:\\/\\/allevents.in\\/spokane-valley\\/200030239607109?ref=bottom_sharer_app\",\"object_type\":\"events\",\"end_url\":\"https:\\/\\/allevents.in\\/spokane-valley\\/event\\/200030239607109\",\"distance\":0,\"ticket\":{\"has_tickets\":false},\"tickets\":{\"has_tickets\":false},\"recurring_event_details\":{\"has_slots\":false},\"display_day\":\"13\",\"display_month\":\"Jul\",\"display_end_day\":\"17\",\"interested_count\":0,\"custom_params\":{\"total_interested_count\":0},\"params\":[],\"app_display_time\":\"Mon, 13 Jul, 2026\",\"display_time_label\":\"13-17 Jul\",\"card_custom_details\":null,\"show_story_share\":true},{\"event_id\":\"200030397493714\",\"eventname\":\"Still & Strong\",\"thumb_url\":\"https:\\/\\/cdn-az.allevents.in\\/events5\\/banners\\/b3d5e1365fed6326977dcae1ca541cf0d5fe9d6989f8a4cd8e40883d03f38cd8-rimg-w960-h960-dcf5f2ed-gmir?v=1783892233\",\"thumb_url_large\":\"https:\\/\\/cdn-az.allevents.in\\/events5\\/banners\\/b3d5e1365fed6326977dcae1ca541cf0d5fe9d6989f8a4cd8e40883d03f38cd8-rimg-w960-h960-dcf5f2ed-gmir?v=1783892233\",\"banner_url\":\"https:\\/\\/cdn-az.allevents.in\\/events5\\/banners\\/b3d5e1365fed6326977dcae1ca541cf0d5fe9d6989f8a4cd8e40883d03f38cd8-rimg-w960-h960-dcf5f2ed-gmir?v=1783892233\",\"start_time\":\"1783935000\",\"timezone\":\"-07:00\",\"description\":\"Still &amp; Strong: The 8-Week Mind-Body Reset\\n\\nStarts July 12th | In-Person at Movement PNW + Virtual Option Available\\n\\nHave you ever felt like you\\u2019re doing everything right, but your body still feels exhausted, stressed, disconnected, or stuck?\\n\\nYou\\u2019re trying to eat better. You\\u2019re trying to exercise. You\\u2019re trying to keep up with life\\u2019s demands.\\n\\nYet you still feel overwhelmed, tired, and like you\\u2019re constantly running on empty.\\n\\nThe truth is, it\\u2019s often not a willpower problem.\\n\\nIt\\u2019s a nervous system problem.\\n\\nStill &amp; Strong is an 8-week transformation experience designed to help women reconnect with their bodies, regulate stress, build strength, and create sustainable wellness habits that last.\\n\\nThrough a unique combination of:\\n\\n\\u2728 Pilates\\n\\u2728 Somatic Movement\\n\\u2728 Nervous System Regulation\\n\\u2728 Meditation &amp; Breathwork\\n\\u2728 Anti-Inflammatory Nutrition\\n\\u2728 Daily Accountability &amp; Support\\n\\nYou\\u2019ll learn how to move, think, eat, and live in a way that helps your body feel safe, energized, and strong again.\\n\\nWhat\\u2019s Included:\\n\\n\\u2714 16 Live Classes (Tuesdays &amp; Thursdays at 9:30 AM)\\n\\u2714 Virtual Replays for Every Session\\n\\u2714 56 Daily Coaching Videos\\n\\u2714 Daily Mantra Text Group\\n\\u2714 8-Week Anti-Inflammatory Meal Plan\\n\\u2714 Confidently Human Guided Workbook\\n\\u2714 Private Community Support\\n\\u2714 Cash &amp; Prize Challenge\\n\\nWhether you\\u2019re brand new to wellness or looking to deepen your journey, this program will meet you exactly where you are.\\n\\nInvestment:\\n\\nVirtual: Starting at $195\\nIn-Person: Starting at $397\\n\\n\\u26a0\\ufe0f In-person participation is intentionally limited to 12 women to create a supportive and intimate experience.\\n\\nThe woman who wins isn\\u2019t the most perfect one.\\n\\nShe\\u2019s the one who shows up.\\n\\nReady to feel Still. And Strong?\\n\\nRegister today at www.movementpnw.com\\n\\nQuestions? Send us a message or comment below and we\\u2019ll help you get started.\",\"end_time\":\"1783938600\",\"start_time_display\":\"Jul 13\",\"location\":\"Movement PNW\",\"venue\":{\"street\":\"321-105 W Hastings Rd,Country Homes, Washington\",\"venue\":\"Movement PNW\",\"city\":\"Fairwood\",\"state\":\"WA\",\"country\":\"United States\",\"latitude\":\"47.76892\",\"longitude\":\"-117.41873\",\"full_address\":\"Movement PNW, 321-105 W Hastings Rd,Country Homes, Washington, Fairwood, United States\"},\"label\":\"Today\",\"featured\":\"0\",\"event_url\":\"https:\\/\\/allevents.in\\/fairwood\\/event\\/200030397493714?ref=eventsearch-event-results\",\"share_url\":\"https:\\/\\/allevents.in\\/fairwood\\/200030397493714?ref=bottom_sharer_app\",\"share_message\":\"Hey, \\n\\nJust found this amazing event happening in Fairwood on AllEvents.\\n\\nWe should totally go!\\n\\nStill & Strong \\n\\n Check it out: https:\\/\\/allevents.in\\/fairwood\\/200030397493714?ref=bottom_sharer_app\",\"share_message_wa\":\"Hey, \\n\\nJust found this amazing event happening in Fairwood on AllEvents.\\n\\nWe should totally go!\\n\\nStill & Strong \\n\\n Check it out: https:\\/\\/allevents.in\\/fairwood\\/200030397493714?ref=bottom_sharer_app\",\"object_type\":\"events\",\"end_url\":\"https:\\/\\/allevents.in\\/fairwood\\/event\\/200030397493714\",\"distance\":0,\"ticket\":{\"has_tickets\":false},\"tickets\":{\"has_tickets\":false},\"recurring_event_details\":{\"has_slots\":false},\"display_day\":\"13\",\"display_month\":\"Jul\",\"display_end_day\":null,\"interested_count\":0,\"custom_params\":{\"total_interested_count\":0},\"params\":[],\"app_display_time\":\"Mon, 13 Jul, 2026\",\"display_time_label\":\"Mon, 13 Jul\",\"card_custom_details\":null,\"show_story_share\":true},{\"event_id\":\"200030361976625\",\"eventname\":\"Covenant Learning Center\",\"thumb_url\":\"https:\\/\\/cdn-az.allevents.in\\/events3\\/banners\\/f12f1d279c5a7d2789f3a5955185aff39c6af9c546d8a029cee15af009bec927-rimg-w1200-h675-dcfffefc-gmir?v=1783319064\",\"thumb_url_large\":\"https:\\/\\/cdn-az.allevents.in\\/events3\\/banners\\/f12f1d279c5a7d2789f3a5955185aff39c6af9c546d8a029cee15af009bec927-rimg-w1200-h675-dcfffefc-gmir?v=1783319064\",\"banner_url\":\"https:\\/\\/cdn-az.allevents.in\\/events3\\/banners\\/f12f1d279c5a7d2789f3a5955185aff39c6af9c546d8a029cee15af009bec927-rimg-w1200-h675-dcfffefc-gmir?v=1783319064\",\"start_time\":\"1783328400\",\"timezone\":\"-07:00\",\"description\":\"The Covenant Learning Center is a community outreach program providing affordable summer experiences for children entering 1st - 12th grade who have difficulty with language, reading, spelling, writing or math due to mild learning disabilities or other special education need, learning English as a second language, below grade-level achievement, and \\/ or poor motivation or management. A certified special-education teacher manages classroom activities and supervises the instructors as well. Tutoring is based on direct instruction methods and a multi-sensory approach.\\n\\nApplication Deadline: June 12th\\nDates: June 29th - August 6th\\nNote: 1-hour pre-testing appointments week prior to start of session.\\n\\nMeeting Days: Monday - Thursdays\\nMeeting times: 9am - Noon OR 1 - 4pm\\n\\nCost: $400 \\/ Students (scholarships are available)\\n\\nFor an application form or more information, please contact June Lamberd at crashnjunebug@gmail.com OR 509.280.1988\",\"end_time\":\"1783933200\",\"start_time_display\":\"Jul 06\",\"location\":\"15515 N Gleneden Dr, Spokane, WA, United States, Washington 99208\",\"venue\":{\"street\":\"15515 N Gleneden St, Spokane, WA 99208-9743, United States\",\"venue\":\"15515 N Gleneden Dr, Spokane, WA, United States, Washington 99208\",\"city\":\"Dartford\",\"state\":\"WA\",\"country\":\"United States\",\"